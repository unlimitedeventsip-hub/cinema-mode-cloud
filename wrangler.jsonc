{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cinema-mode-cloud",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-10",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "r2_buckets": [
    {
      "binding": "CINEMA_BUCKET",
      "bucket_name": "cinema-films"
    }
  ]
}
